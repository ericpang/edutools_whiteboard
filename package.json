{
  "name": "edutools-whiteboard",
  "private": true,
  "type": "module",
  "description": "Real-time collaborative classroom whiteboard: a static site on Firebase Realtime Database.",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-cuteworld",
    "serve": "http-server -c-1 -p 8080",
    "test": "node --test \"tests/*.test.js\"",
    "test:rules": "firebase emulators:exec --project demo-cuteworld \"node --test tests/rules/*.test.js\"",
    "test:e2e": "node tests/e2e/walkthrough.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.2.0",
    "firebase-tools": "^15.35.0",
    "http-server": "^14.1.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.16.0"
  }
}
