{
  "rules": {
    "sessions": {
      "$code": {
        ".read": true,
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('owner').val() === auth.uid)",
          ".validate": "newData.child('owner').val() === auth.uid && newData.child('topic').isString() && newData.child('topic').val().length > 0 && newData.child('topic').val().length <= 200 && newData.child('open').isBoolean() && newData.child('maxPerUser').isNumber()"
        },
        "hidden": {
          ".write": "auth != null && root.child('sessions/' + $code + '/meta/owner').val() === auth.uid"
        },
        "words": {
          ".write": "auth != null && root.child('sessions/' + $code + '/meta/owner').val() === auth.uid",
          ".indexOn": ["uid"],
          "$wordId": {
            ".write": "auth != null && !data.exists() && root.child('sessions/' + $code + '/meta/open').val() === true",
            ".validate": "newData.hasChildren(['text', 'uid', 'ts']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 40 && newData.child('uid').val() === auth.uid && newData.child('ts').val() === now"
          }
        }
      }
    },
    "boards": {
      "$code": {
        ".read": "auth != null && data.child('meta/owner').val() === auth.uid",
        "meta": {
          ".read": true,
          ".write": "auth != null && (!data.exists() || data.child('owner').val() === auth.uid)",
          ".validate": "newData.hasChildren(['title', 'owner', 'layout', 'open', 'approval', 'revealed', 'showNames', 'maxPerUser', 'createdAt']) && newData.child('owner').val() === auth.uid && (newData.child('layout').val() === 'wall' || newData.child('columns').exists())",
          "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
          "owner": { ".validate": "newData.isString()" },
          "layout": { ".validate": "newData.val() === 'wall' || newData.val() === 'columns'" },
          "columns": {
            "$col": {
              ".validate": "newData.hasChildren(['name', 'order'])",
              "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
              "order": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "open": { ".validate": "newData.isBoolean()" },
          "approval": { ".validate": "newData.isBoolean()" },
          "revealed": { ".validate": "newData.isBoolean()" },
          "showNames": { ".validate": "newData.isBoolean()" },
          "maxPerUser": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "groups": { ".validate": "newData.isNumber() && (newData.val() === 0 || (newData.val() >= 2 && newData.val() <= 12))" },
          "groupSeed": { ".validate": "newData.isNumber()" },
          "chat": { ".validate": "newData.isBoolean()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "posts": {
          ".read": "auth != null && (root.child('boards/' + $code + '/meta/revealed').val() === true || (query.orderByChild === 'uid' && query.equalTo === auth.uid))",
          ".write": "auth != null && root.child('boards/' + $code + '/meta/owner').val() === auth.uid",
          ".indexOn": ["uid"],
          "$postId": {
            ".write": "auth != null && root.child('boards/' + $code + '/meta/open').val() === true && ((root.child('boards/' + $code + '/meta/approval').val() !== true && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid)) || (data.child('uid').val() === auth.uid && !newData.exists()))",
            ".validate": "newData.hasChildren(['text', 'color', 'uid', 'ts'])",
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 3000" },
            "color": { ".validate": "newData.isString() && newData.val().matches(/^(yellow|pink|blue|green|purple|orange)$/)" },
            "column": { ".validate": "newData.isString() && root.child('boards/' + $code + '/meta/columns/' + newData.val()).exists()" },
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
            "uid": { ".validate": "newData.isString() && (newData.val() === auth.uid || root.child('boards/' + $code + '/meta/owner').val() === auth.uid)" },
            "ts": { ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val() || (root.child('boards/' + $code + '/meta/owner').val() === auth.uid && newData.val() <= now))" },
            "editedAt": { ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val() || root.child('boards/' + $code + '/meta/owner').val() === auth.uid)" },
            "highlighted": { ".validate": "newData.isBoolean() && (newData.val() === false || newData.val() === data.val() || root.child('boards/' + $code + '/meta/owner').val() === auth.uid)" },
            "group": { ".validate": "newData.isNumber() && (newData.val() === root.child('boards/' + $code + '/members/' + auth.uid + '/group').val() || root.child('boards/' + $code + '/meta/owner').val() === auth.uid)" },
            "$other": { ".validate": false }
          }
        },
        "pending": {
          ".read": "auth != null && query.orderByChild === 'uid' && query.equalTo === auth.uid",
          ".write": "auth != null && root.child('boards/' + $code + '/meta/owner').val() === auth.uid",
          ".indexOn": ["uid"],
          "$postId": {
            ".write": "auth != null && root.child('boards/' + $code + '/meta/open').val() === true && ((!data.exists() && newData.child('uid').val() === auth.uid && root.child('boards/' + $code + '/meta/approval').val() === true) || data.child('uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['text', 'color', 'uid', 'ts'])",
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 3000" },
            "color": { ".validate": "newData.isString() && newData.val().matches(/^(yellow|pink|blue|green|purple|orange)$/)" },
            "column": { ".validate": "newData.isString() && root.child('boards/' + $code + '/meta/columns/' + newData.val()).exists()" },
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
            "uid": { ".validate": "newData.isString() && (newData.val() === auth.uid || root.child('boards/' + $code + '/meta/owner').val() === auth.uid)" },
            "ts": { ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val() || (root.child('boards/' + $code + '/meta/owner').val() === auth.uid && newData.val() <= now))" },
            "editedAt": { ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val() || root.child('boards/' + $code + '/meta/owner').val() === auth.uid)" },
            "highlighted": { ".validate": "newData.isBoolean() && (newData.val() === false || newData.val() === data.val() || root.child('boards/' + $code + '/meta/owner').val() === auth.uid)" },
            "group": { ".validate": "newData.isNumber() && (newData.val() === root.child('boards/' + $code + '/members/' + auth.uid + '/group').val() || root.child('boards/' + $code + '/meta/owner').val() === auth.uid)" },
            "hidden": { ".validate": "newData.isBoolean() && (newData.val() === data.val() || root.child('boards/' + $code + '/meta/owner').val() === auth.uid)" },
            "$other": { ".validate": false }
          }
        },
        "likes": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('boards/' + $code + '/meta/owner').val() === auth.uid",
          "$postId": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.val() === true && root.child('boards/' + $code + '/posts/' + $postId).exists()"
            }
          }
        },
        "joinCount": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('boards/' + $code + '/meta/groups').val() > 0 || root.child('boards/' + $code + '/meta/owner').val() === auth.uid)",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)"
        },
        "members": {
          ".write": "auth != null && root.child('boards/' + $code + '/meta/owner').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.hasChildren(['group', 'slot', 'ts'])",
            "group": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= root.child('boards/' + $code + '/meta/groups').val()" },
            "slot": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < root.child('boards/' + $code + '/joinCount').val()" },
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
            "ts": { ".validate": "newData.isNumber() && newData.val() === now" },
            "$other": { ".validate": false }
          }
        },
        "chat": {
          ".read": "auth != null && root.child('boards/' + $code + '/members/' + auth.uid).exists() && query.orderByChild === 'group' && query.equalTo === root.child('boards/' + $code + '/members/' + auth.uid + '/group').val()",
          ".write": "auth != null && root.child('boards/' + $code + '/meta/owner').val() === auth.uid",
          ".indexOn": ["group"],
          "$msgId": {
            ".write": "auth != null && !data.exists() && root.child('boards/' + $code + '/meta/chat').val() === true && root.child('boards/' + $code + '/members/' + auth.uid).exists() && newData.child('group').val() === root.child('boards/' + $code + '/members/' + auth.uid + '/group').val()",
            ".validate": "newData.hasChildren(['group', 'uid', 'slot', 'text', 'ts']) && (data.exists() || !newData.hasChild('likes'))",
            "group": { ".validate": "newData.isNumber()" },
            "uid": { ".validate": "newData.val() === auth.uid" },
            "slot": { ".validate": "newData.isNumber() && newData.val() === root.child('boards/' + $code + '/members/' + auth.uid + '/slot').val()" },
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
            "ts": { ".validate": "newData.isNumber() && newData.val() === now" },
            "likes": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('boards/' + $code + '/meta/chat').val() === true && root.child('boards/' + $code + '/members/' + auth.uid).exists() && root.child('boards/' + $code + '/chat/' + $msgId + '/group').val() === root.child('boards/' + $code + '/members/' + auth.uid + '/group').val() && root.child('boards/' + $code + '/chat/' + $msgId + '/uid').val() !== auth.uid",
                ".validate": "newData.hasChild('slot')",
                "slot": { ".validate": "newData.isNumber() && newData.val() === root.child('boards/' + $code + '/members/' + $uid + '/slot').val()" },
                "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "polls": {
      "$code": {
        ".read": "auth != null && data.child('meta/owner').val() === auth.uid",
        "meta": {
          ".read": true,
          ".write": "auth != null && (!data.exists() || data.child('owner').val() === auth.uid)",
          ".validate": "newData.hasChildren(['title', 'owner', 'current', 'open', 'showResults', 'shareResults', 'revealed', 'createdAt']) && newData.child('owner').val() === auth.uid",
          "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
          "owner": { ".validate": "newData.isString()" },
          "current": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
          "open": { ".validate": "newData.isBoolean()" },
          "showResults": { ".validate": "newData.isBoolean()" },
          "shareResults": { ".validate": "newData.isBoolean()" },
          "revealed": { ".validate": "newData.isBoolean()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "questions": {
          ".read": true,
          ".write": "auth != null && root.child('polls/' + $code + '/meta/owner').val() === auth.uid",
          "$qid": {
            ".validate": "newData.hasChildren(['order', 'type', 'text']) && (newData.child('type').val() !== 'rating' || newData.hasChild('scale')) && ((newData.child('type').val() !== 'single' && newData.child('type').val() !== 'multi') || newData.hasChild('options'))",
            "order": { ".validate": "newData.isNumber()" },
            "type": { ".validate": "newData.isString() && newData.val().matches(/^(single|multi|rating|text)$/)" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
            "options": {
              "$opt": {
                ".validate": "newData.hasChildren(['label', 'order'])",
                "label": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
                "order": { ".validate": "newData.isNumber()" },
                "$other": { ".validate": false }
              }
            },
            "quiz": { ".validate": "newData.isBoolean()" },
            "scale": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 10" },
            "low": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "high": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$other": { ".validate": false }
          }
        },
        "answers": {
          ".write": "auth != null && root.child('polls/' + $code + '/meta/owner').val() === auth.uid",
          "$qid": {
            ".read": "auth != null && root.child('polls/' + $code + '/meta/current').val() === $qid && root.child('polls/' + $code + '/meta/revealed').val() === true",
            "$opt": { ".validate": "newData.val() === true" }
          }
        },
        "responses": {
          ".write": "auth != null && root.child('polls/' + $code + '/meta/owner').val() === auth.uid",
          "$qid": {
            ".read": "auth != null && root.child('polls/' + $code + '/meta/current').val() === $qid && root.child('polls/' + $code + '/meta/shareResults').val() === true",
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && root.child('polls/' + $code + '/meta/current').val() === $qid && root.child('polls/' + $code + '/meta/open').val() === true",
              ".validate": "newData.hasChild('ts') && (newData.hasChild('choice') || newData.hasChild('choices') || newData.hasChild('rating') || newData.hasChild('text')) && root.child('polls/' + $code + '/questions/' + $qid).exists()",
              "ts": { ".validate": "newData.isNumber() && newData.val() === now" },
              "choice": { ".validate": "newData.isString() && root.child('polls/' + $code + '/questions/' + $qid + '/type').val() === 'single' && root.child('polls/' + $code + '/questions/' + $qid + '/options/' + newData.val()).exists()" },
              "choices": {
                ".validate": "root.child('polls/' + $code + '/questions/' + $qid + '/type').val() === 'multi' && newData.hasChildren()",
                "$opt": { ".validate": "newData.val() === true && root.child('polls/' + $code + '/questions/' + $qid + '/options/' + $opt).exists()" }
              },
              "rating": { ".validate": "newData.isNumber() && root.child('polls/' + $code + '/questions/' + $qid + '/type').val() === 'rating' && newData.val() >= 1 && newData.val() <= root.child('polls/' + $code + '/questions/' + $qid + '/scale').val()" },
              "text": { ".validate": "newData.isString() && root.child('polls/' + $code + '/questions/' + $qid + '/type').val() === 'text' && newData.val().length > 0 && newData.val().length <= 140" },
              "$other": { ".validate": false }
            }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "mindmaps": {
      "$code": {
        ".validate": "$code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
        ".read": "auth != null && !root.child('mindmaps/' + $code + '/meta/banned/' + auth.uid).exists()",
        ".write": "auth != null && data.child('meta/owner').val() === auth.uid",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('owner').val() === auth.uid)",
          ".validate": "newData.hasChildren(['owner', 'title', 'locked', 'createdAt']) && newData.child('owner').val() === auth.uid",
          "owner": { ".validate": "newData.isString()" },
          "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
          "locked": { ".validate": "newData.isBoolean()" },
          "ownOnly": { ".validate": "newData.isBoolean()" },
          "banned": {
            ".validate": "newData.hasChildren()",
            "$uid": { ".validate": "$uid.matches(/^[A-Za-z0-9_-]{1,128}$/) && newData.val() === true" }
          },
          "createdAt": { ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())" },
          "$other": { ".validate": false }
        },
        "nodes": {
          "$id": {
            ".write": "auth != null && root.child('mindmaps/' + $code + '/meta/owner').exists() && !root.child('mindmaps/' + $code + '/meta/banned/' + auth.uid).exists() && root.child('mindmaps/' + $code + '/meta/locked').val() !== true && (root.child('mindmaps/' + $code + '/meta/ownOnly').val() !== true || !data.exists() || data.child('creator').val() === auth.uid)",
            ".validate": "$id.matches(/^n_[a-z0-9]{12}$/) && newData.hasChildren(['order', 'text', 'by', 'at', 'creator']) && newData.child('by').val() === auth.uid && (data.exists() ? newData.child('creator').val() === data.child('creator').val() : newData.child('creator').val() === auth.uid)",
            "parent": { ".validate": "newData.isString() && newData.val() !== $id && newData.val().matches(/^n_[a-z0-9]{12}$/)" },
            "order": { ".validate": "newData.isNumber()" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
            "color": { ".validate": "newData.isString() && newData.val().matches(/^c[1-8]$/)" },
            "shape": { ".validate": "newData.isString() && newData.val().matches(/^(rounded|pill|rect|diamond)$/)" },
            "emoji": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16" },
            "by": { ".validate": "newData.isString()" },
            "at": { ".validate": "newData.isNumber() && newData.val() === now" },
            "creator": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('mindmaps/' + $code + '/meta/owner').exists() && !root.child('mindmaps/' + $code + '/meta/banned/' + auth.uid).exists()",
            ".validate": "newData.hasChildren(['name', 'color', 'at'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
            "color": { ".validate": "newData.isString() && newData.val().matches(/^c[1-8]$/)" },
            "selected": { ".validate": "newData.isString() && newData.val().matches(/^n_[a-z0-9]{12}$/)" },
            "editing": { ".validate": "newData.isString() && newData.val().matches(/^n_[a-z0-9]{12}$/)" },
            "at": { ".validate": "newData.isNumber() && newData.val() === now" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "worlds": {
      "$code": {
        ".validate": "$code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
        ".read": "auth != null && data.child('meta/owner').val() === auth.uid",
        ".write": "auth != null && data.child('meta/owner').val() === auth.uid",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('owner').val() === auth.uid)",
          ".validate": "newData.hasChildren(['owner', 'env', 'open', 'chat', 'bubbles', 'createdAt']) && newData.child('owner').val() === auth.uid",
          "owner": { ".validate": "newData.isString()" },
          "env": { ".validate": "newData.isString() && newData.val().matches(/^(school|jungle|shopping)$/)" },
          "open": { ".validate": "newData.isBoolean()" },
          "chat": { ".validate": "newData.isBoolean()" },
          "bubbles": { ".validate": "newData.isBoolean()" },
          "createdAt": { ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())" },
          "$other": { ".validate": false }
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !root.child('worlds/' + $code + '/banned/' + $uid).exists() && (data.exists() || root.child('worlds/' + $code + '/meta/open').val() === true)",
            ".validate": "newData.hasChildren(['name', 'persona', 'color', 'on'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
            "persona": { ".validate": "newData.val() === 'male' || newData.val() === 'female'" },
            "color": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100" },
            "on": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "pos": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('worlds/' + $code + '/players/' + $uid).exists()",
            ".validate": "newData.hasChildren(['x', 'y'])",
            "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1920" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1080" },
            "$other": { ".validate": false }
          }
        },
        "group": {
          ".read": "auth != null",
          "$uid": { ".validate": "newData.isString() && newData.val().matches(/^g[0-9]{1,2}$/)" }
        },
        "banned": {
          "$uid": { ".validate": "newData.val() === true" }
        },
        "chats": {
          "$pair": {
            ".read": "auth != null && ($pair.beginsWith(auth.uid) || $pair.endsWith(auth.uid))",
            "$msg": {
              ".write": "auth != null && !data.exists() && root.child('worlds/' + $code + '/meta/chat').val() === true && ($pair.beginsWith(auth.uid) || $pair.endsWith(auth.uid)) && root.child('worlds/' + $code + '/players/' + auth.uid).exists() && root.child('worlds/' + $code + '/players/' + $pair.replace(auth.uid, '').replace('_', '')).exists()",
              ".validate": "newData.hasChildren(['from', 'text', 'ts'])",
              "from": { ".validate": "newData.val() === auth.uid" },
              "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
              "ts": { ".validate": "newData.val() === now" },
              "$other": { ".validate": false }
            }
          }
        },
        "quiz": {
          "cur": {
            ".read": "auth != null",
            ".validate": "newData.hasChildren(['id', 'text', 'type', 'mode', 'state', 'ts'])",
            "id": { ".validate": "newData.isString() && newData.val().matches(/^q[0-9]{1,4}$/)" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
            "type": { ".validate": "newData.val() === 'choice' || newData.val() === 'text'" },
            "options": {
              "$i": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" }
            },
            "mode": { ".validate": "newData.val() === 'solo' || newData.val() === 'group'" },
            "state": { ".validate": "newData.val() === 'open' || newData.val() === 'closed' || newData.val() === 'revealed'" },
            "answer": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "ts": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "key": {
            "$qid": { ".validate": "newData.isString() && newData.val().length <= 200" }
          },
          "ans": {
            "$qid": {
              "$subject": {
                ".read": "auth != null && ($subject === auth.uid || $subject === root.child('worlds/' + $code + '/group/' + auth.uid).val())",
                ".write": "auth != null && root.child('worlds/' + $code + '/quiz/cur/id').val() === $qid && root.child('worlds/' + $code + '/quiz/cur/state').val() === 'open' && (root.child('worlds/' + $code + '/quiz/cur/mode').val() === 'solo' ? $subject === auth.uid : $subject === root.child('worlds/' + $code + '/group/' + auth.uid).val())",
                ".validate": "newData.hasChildren(['v', 'by', 'ts'])",
                "v": { ".validate": "newData.isString() && newData.val().length <= 200" },
                "by": { ".validate": "newData.val() === auth.uid" },
                "ts": { ".validate": "newData.val() === now" },
                "$other": { ".validate": false }
              }
            }
          },
          "score": {
            ".read": "auth != null",
            "$subject": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          },
          "$other": { ".validate": false }
        },
        "treasure": {
          "chests": {
            ".read": "auth != null",
            "$cid": {
              ".validate": "$cid.matches(/^[A-Za-z0-9_-]{1,24}$/) && newData.hasChildren(['x', 'y', 'text', 'type'])",
              "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1920" },
              "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1080" },
              "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
              "type": { ".validate": "newData.val() === 'choice' || newData.val() === 'text'" },
              "options": {
                "$i": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" }
              },
              "$other": { ".validate": false }
            }
          },
          "key": {
            "$cid": { ".validate": "newData.isString() && newData.val().length <= 200" }
          },
          "ans": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              "$cid": {
                ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('worlds/' + $code + '/treasure/chests/' + $cid).exists() && root.child('worlds/' + $code + '/players/' + $uid).exists()",
                ".validate": "newData.hasChildren(['v', 'ts'])",
                "v": { ".validate": "newData.isString() && newData.val().length <= 200" },
                "ts": { ".validate": "newData.val() === now" },
                "$other": { ".validate": false }
              }
            }
          },
          "res": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              "$cid": {
                ".validate": "!data.exists() && newData.hasChild('ok')",
                "ok": { ".validate": "newData.isBoolean()" },
                "a": { ".validate": "newData.isString() && newData.val().length <= 200" },
                "$other": { ".validate": false }
              }
            }
          },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "whiteboards": {
      "$code": {
        ".validate": "$code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
        ".read": "auth != null && data.child('meta/owner').val() === auth.uid",
        ".write": "auth != null && data.child('meta/owner').val() === auth.uid",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('owner').val() === auth.uid)",
          ".validate": "newData.hasChildren(['owner', 'title', 'locked', 'requireApproval', 'createdAt']) && newData.child('owner').val() === auth.uid",
          "owner": { ".validate": "newData.isString()" },
          "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
          "locked": { ".validate": "newData.isBoolean()" },
          "requireApproval": { ".validate": "newData.isBoolean()" },
          "createdAt": { ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())" },
          "$other": { ".validate": false }
        },
        "students": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('whiteboards/' + $code + '/meta/owner').exists() && !root.child('whiteboards/' + $code + '/banned/' + $uid).exists()",
            ".validate": "newData.hasChildren(['name', 'status', 'joinedAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
            "status": { ".validate": "newData.isString() && (newData.val() === 'pending' || (newData.val() === 'active' && (root.child('whiteboards/' + $code + '/meta/requireApproval').val() !== true || root.child('whiteboards/' + $code + '/meta/owner').val() === auth.uid)))" },
            "viewOnly": { ".validate": "newData.isBoolean() && root.child('whiteboards/' + $code + '/meta/owner').val() === auth.uid" },
            "joinedAt": { ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())" },
            "$other": { ".validate": false }
          }
        },
        "banned": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".validate": "$uid.matches(/^[A-Za-z0-9_-]{1,128}$/) && newData.hasChildren(['name', 'at'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
            "at": { ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())" },
            "$other": { ".validate": false }
          }
        },
        "items": {
          ".read": "auth != null && !root.child('whiteboards/' + $code + '/banned/' + auth.uid).exists() && root.child('whiteboards/' + $code + '/students/' + auth.uid + '/status').val() === 'active'",
          ".indexOn": ["uid"],
          "$id": {
            ".write": "auth != null && !root.child('whiteboards/' + $code + '/banned/' + auth.uid).exists() && root.child('whiteboards/' + $code + '/students/' + auth.uid + '/status').val() === 'active' && root.child('whiteboards/' + $code + '/meta/locked').val() !== true && root.child('whiteboards/' + $code + '/students/' + auth.uid + '/viewOnly').val() !== true && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['type', 'uid', 'color', 'size', 'ts']) && newData.child('uid').val() === auth.uid && ((newData.child('type').val() === 'stroke' && newData.hasChild('pts') && !newData.hasChild('text')) || (newData.child('type').val() === 'text' && newData.hasChildren(['text', 'x', 'y']) && !newData.hasChild('pts')))",
            "type": { ".validate": "newData.val() === 'stroke' || newData.val() === 'text'" },
            "uid": { ".validate": "newData.isString()" },
            "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f]{6}$/)" },
            "size": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 120" },
            "pts": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20000 && newData.val().matches(/^[0-9 ,]+$/)" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
            "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1920" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1080" },
            "ts": { ".validate": "newData.isNumber() && newData.val() === now" },
            "$other": { ".validate": false }
          }
        },
        "live": {
          ".read": "auth != null && !root.child('whiteboards/' + $code + '/banned/' + auth.uid).exists() && root.child('whiteboards/' + $code + '/students/' + auth.uid + '/status').val() === 'active'",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (auth != null && !root.child('whiteboards/' + $code + '/banned/' + auth.uid).exists() && root.child('whiteboards/' + $code + '/students/' + auth.uid + '/status').val() === 'active' && root.child('whiteboards/' + $code + '/meta/locked').val() !== true && root.child('whiteboards/' + $code + '/students/' + auth.uid + '/viewOnly').val() !== true))",
            ".validate": "newData.hasChildren(['pts', 'color', 'size'])",
            "pts": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20000 && newData.val().matches(/^[0-9 ,]+$/)" },
            "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f]{6}$/)" },
            "size": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 120" },
            "$other": { ".validate": false }
          }
        },
        "presence": {
          ".read": "auth != null && !root.child('whiteboards/' + $code + '/banned/' + auth.uid).exists() && root.child('whiteboards/' + $code + '/students/' + auth.uid + '/status').val() === 'active'",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (!root.child('whiteboards/' + $code + '/banned/' + auth.uid).exists() && root.child('whiteboards/' + $code + '/students/' + $uid).exists()))",
            ".validate": "newData.hasChildren(['name', 'color', 'at'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24 && (newData.val() === root.child('whiteboards/' + $code + '/students/' + $uid + '/name').val() || root.child('whiteboards/' + $code + '/meta/owner').val() === $uid)" },
            "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f]{6}$/)" },
            "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1920" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1080" },
            "at": { ".validate": "newData.isNumber() && newData.val() === now" },
            "$other": { ".validate": false }
          }
        },
        "background": {
          ".read": "auth != null && !root.child('whiteboards/' + $code + '/banned/' + auth.uid).exists() && root.child('whiteboards/' + $code + '/students/' + auth.uid + '/status').val() === 'active'",
          ".validate": "newData.hasChildren(['img', 'w', 'h', 'at'])",
          "img": { ".validate": "newData.isString() && newData.val().length <= 1500000 && (newData.val().beginsWith('data:image/png;base64,') || newData.val().beginsWith('data:image/jpeg;base64,'))" },
          "w": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4096" },
          "h": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4096" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "at": { ".validate": "newData.isNumber() && newData.val() === now" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
